# ------------------------------------------------------------------ app
APP_NAME="yourqm_v1"
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# --------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true
LOG_PROMPTS=false

# -------------------------------------------------------------- security
# Generate a long random value, e.g.: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=3uf0EPjy48gYZVLwn0Zz4OFoUuIN7U-wADfhtgHx804aly8iO0BDdnAy-l9Y06Bedo2rK6LJfiSg9NWT35ugAg
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# Argon2id hash produced by: python -m scripts.generate_admin_hash
ADMIN_PASSWORD_HASH=
# Development-only convenience login. Leave blank in production.
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourqm.com.au,https://www.yourqm.com.au
MAX_REQUEST_BODY_BYTES=262144

# ------------------------------------------------------------- database
# Local default uses SQLite. Production uses PostgreSQL (see compose.yaml):
#   postgresql+asyncpg://yourqm_v1:password@localhost:5432/yourqm_v1
DATABASE_URL=sqlite+aiosqlite:///./data/yourqm_v1.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -------------------------------------------------------------- redis
# Optional. When set, rate limiting uses Redis so limits are shared across replicas.
REDIS_URL=

# ------------------------------------------------------------ rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_HOUR=200
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CONTACT_PER_HOUR=10

# ------------------------------------------------------------ AI provider
# AI_PROVIDER: openai | anthropic  (openai also works for Azure/OpenRouter/self-hosted via AI_BASE_URL)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.2
AI_STREAMING_ENABLED=true

# ------------------------------------------------------------------ chat
CHAT_SESSION_TTL_HOURS=168
CHAT_MAX_INPUT_CHARS=4000
CHAT_MAX_CONTEXT_MESSAGES=12
CHAT_MAX_MESSAGES_PER_SESSION=200
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_TOOLS_ENABLED=true

# -------------------------------------------------------------- retrieval
KNOWLEDGE_ENABLED=true
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.05
KNOWLEDGE_URL_ALLOWLIST=yourqm.com.au,www.yourqm.com.au

# ---------------------------------------------------------- integrations
# Bridge to the existing Supabase project behind yourqm.com.au.
# Paste the service_role secret below (Project Settings -> API -> service_role).
# Keep this file secret: it is gitignored. Never commit or log the key.
SUPABASE_URL=https://nvfyldrfrrdsteuungjv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CONTACT_TABLE=contact_submissions
CONTACT_FORWARD_TIMEOUT_SECONDS=10
